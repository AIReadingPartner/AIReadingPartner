# Copy to server/.env and fill in. server/.env is gitignored — never commit real values.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_KEY=your-gemini-api-key

# MongoDB Atlas connection string (must support Atlas Vector Search for the RAG store)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai-reading-partner

# Optional: server port (defaults to 3030)
PORT=3030
